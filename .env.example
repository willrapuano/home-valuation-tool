# ============================================================
# Home Valuation Tool — Environment Variables
# ============================================================
#
# ⚠️  KEY ROTATION REQUIRED
# Earlier versions of this repo had API keys hardcoded in source and
# committed to git history. Those keys must be treated as compromised
# and rotated in their respective consoles before this deploys again.
# ============================================================


# ── Property valuation upstream ─────────────────────────────
# The service that returns property-level estimates.
#
# MUST be a stable hostname. A *.trycloudflare.com Quick Tunnel gets a new
# random URL every time it restarts, so the tool silently degrades to a
# ZIP-code average the moment it drops. Use a named Cloudflare tunnel or a
# hosted API endpoint.
#
# If unset, the tool skips the lookup and returns a clearly-labelled
# neighbourhood estimate instead.
VALUATION_API_URL=
VALUATION_API_KEY=


# ── Google Maps (server-side only) ──────────────────────────
# Used by /api/streetview to fetch property imagery. This key is never sent
# to the browser, so restrict it by API (Street View Static API) rather than
# by HTTP referrer.
GOOGLE_MAPS_API_KEY=


# ── DataTrace TitleFlex — comparable sales (SCAFFOLDED) ─────
# Powers lib/comps/providers/titleflex.ts.
#
# ⚠️  The field mapping in that provider is PROVISIONAL — written from
# TitleFlex product descriptions, not their API spec. Before relying on it,
# call the provider's describe() helper against a real response and reconcile
# the reported keys against FIELD_ALIASES.
#
# These MUST be API credentials issued by DataTrace for programmatic access —
# not a titleflex.com web portal login.
TITLEFLEX_API_URL=
TITLEFLEX_API_KEY=

# Auth shape. Defaults suit a bearer token; for a raw-key header set
# TITLEFLEX_AUTH_HEADER=X-API-Key and TITLEFLEX_AUTH_SCHEME= (empty).
TITLEFLEX_AUTH_HEADER=Authorization
TITLEFLEX_AUTH_SCHEME=Bearer

# Endpoint returning nearby closed sales, relative to TITLEFLEX_API_URL.
TITLEFLEX_SEARCH_PATH=/property/sales/search
TITLEFLEX_TIMEOUT_MS=8000


# ── Census ACS — ZIP-level median household income ──────────
# Free, issued instantly. The Census data API now REQUIRES a key on every
# request; unkeyed calls return an HTML "Missing Key" page with a 200 status.
# Get one at: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=


# ── HUD — Fair Market Rents ─────────────────────────────────
# Free. Without it, the rental section falls back to static NoVA averages.
# Get one at: https://www.huduser.gov/portal/dataset/fmr-api.html
HUD_API_TOKEN=


# ── GoHighLevel CRM ─────────────────────────────────────────
# Location-level API key (not the agency key).
# GHL Dashboard → Settings → Integrations → API Keys
GHL_API_KEY=
GHL_LOCATION_ID=


# ── Deployment ──────────────────────────────────────────────
# Public origin used to build shareable report links. Falls back to
# VERCEL_URL when unset.
NEXT_PUBLIC_BASE_URL=


# ============================================================
# Agent Branding (update for each client deployment)
# ============================================================
NEXT_PUBLIC_AGENT_NAME=Agent Name
NEXT_PUBLIC_AGENT_EMAIL=agent@brokerage.com
NEXT_PUBLIC_AGENT_PHONE=(555) 555-5555
NEXT_PUBLIC_AGENT_BROKERAGE=Brokerage Name
NEXT_PUBLIC_AGENT_LICENSE=State License Number
